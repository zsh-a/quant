# Frontend Dockerfile - Multi-stage build with Bun
FROM oven/bun:1-alpine AS builder

WORKDIR /app

# Aliyun npm mirror
RUN echo 'registry = "https://registry.npmmirror.com"' > /root/.bunfig.toml

# Copy dependency files FIRST — cached unless package.json/bun.lock change
COPY ui/package.json ui/bun.lock* ./

# Install dependencies (cached layer)
RUN bun install --frozen-lockfile 2>/dev/null || bun install

# Copy source code (changes frequently — separate layer)
COPY ui/ ./

# Build production bundle
RUN bun run build

# Production stage - Nginx
FROM nginx:alpine

# Aliyun alpine mirror
RUN sed -i 's|dl-cdn.alpinelinux.org|mirrors.aliyun.com|g' /etc/apk/repositories

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
